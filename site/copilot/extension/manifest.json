{
  "manifest_version": 3,
  "name": "Quick Come 副驾驶",
  "version": "0.3.3",
  "description": "刷 X、Threads 首页时，营销团队标出值得回的帖子、写回复草稿；你同意后在官方回复窗口自己按发送。",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "打开副驾驶" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.threads.com/*", "https://www.threads.net/*"],
      "js": ["parse.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
